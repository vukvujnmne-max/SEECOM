
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/uswds/Breadcrumb.astro';
import { siteConfig } from '../../config/site';
import type { Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    {
      params: { lang: undefined },
      props: { locale: 'en' as Locale },
    },
  ];
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const title = 'About SEECOM';
const description =
  'Learn about SEECOM, an informal international professional forum for public sector communicators in South East Europe.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About SEECOM', href: '/about/' },
];
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="grid-container usa-section">
    <div class="grid-row">
      <div class="grid-col-12 tablet:grid-col-8">
        <Breadcrumb items={breadcrumbs} />

        <h1>About SEECOM</h1>

<div class="usa-prose seecom-justified">
<p>
SEECOM is an informal international professional forum established in Budva, Montenegro, in 2012. It connects public-sector communication professionals across South East Europe to promote high professional and ethical standards and support good governance through the exchange of experience and expertise.
          </p>

          <p>
            Over the years, the Forum has brought together directors of government communications offices, communications advisers to heads of government, government spokespersons and other senior public-sector communicators from across the region.
          </p>

          <p>
            SEECOM’s founding credo is that effective, professional and ethical communication not only informs citizens but also gives them a greater say in how public policies are developed, while helping policymakers shape policies that are better tailored to citizens’ needs, expectations and concerns.
          </p>

<p>
These principles are reflected in the Budva Declaration, adopted in September 2012 by senior government communication officials from South East Europe. It is Europe’s first transnational declaration setting out core professional and ethical principles for government communication.
</p>

          <p>
After a period as a formally established association, SEECOM continues as an informal professional network, returning to the professional exchange model on which it was founded.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
